---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { ImageMetadata, MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { configImageBaseRoots, siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { resolveConfigImage } from "../utils/image-source";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string | ImageMetadata;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	enablePhotoSwipe?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	enablePhotoSwipe = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
const bannerSource = await resolveConfigImage(
	siteConfig.banner.src,
	configImageBaseRoots.banner,
);

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} enablePhotoSwipe={enablePhotoSwipe}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 page-shell page-shell-gutter" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={bannerSource} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative page-shell pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 layout-main-grid
    mx-auto page-shell-gutter"
        >
            <!-- Banner image credit -->
            {hasBannerCredit &&
                (hasBannerLink
                    ? <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                         class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                         "px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
                    >
                        <Icon class="text-white/75 text-xl mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                        <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                        <Icon class:list={["transition absolute text-banner-credit-accent right-4 text-xs opacity-0",
                            {"group-hover:opacity-100": hasBannerLink}]}
                              name="fa6-solid:arrow-up-right-from-square">
                        </Icon>
                    </a>
                    : <div id="banner-credit"
                           class="group onload-animation transition-all absolute flex justify-center items-center rounded-full px-3 right-4 -top-13 bg-black/60 h-9"
                    >
                        <Icon class="text-white/75 text-xl mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                        <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                    </div>
                )
            }


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-70 onload-animation" headings={headings}></SideBar>

			<main
				id="swup-container"
				data-swup-announcement={title}
				data-enable-photoswipe={enablePhotoSwipe}
				class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden"
			>
				<div id="content-wrapper" class="onload-animation">
					<!-- the overflow-hidden here prevent long text break the layout-->
					<!-- make id different from windows.swup global property -->
					<slot></slot>
				</div>
			</main>

			<div class="footer col-span-2 onload-animation">
				<Footer></Footer>
			</div>
		</div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative page-shell">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 toc-rail items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 toc-scroll-region overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>
