---
import { Font } from "astro:assets";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import GlobalStyles from "@components/GlobalStyles.astro";
import GlobalNotices from "@components/misc/GlobalNotices.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { ImageMetadata } from "astro";
import photoSwipeStylesUrl from "photoswipe/style.css?url";
import { configImageBaseRoots, profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { floatingScrollbarMedia } from "../utils/browser/floating-scrollbars";
import { resolveConfigAssetUrl } from "../utils/image-source";
import { pathsEqual, url } from "../utils/permalink/urls";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string | ImageMetadata;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	enablePhotoSwipe?: boolean;
	canonicalPath?: string;
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	enablePhotoSwipe = false,
	canonicalPath,
} = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const resolvedFavicons: Favicon[] = await Promise.all(
	favicons.map(async (favicon) => ({
		...favicon,
		src:
			(await resolveConfigAssetUrl(
				favicon.src,
				configImageBaseRoots.favicon,
			)) ?? favicon.src,
	})),
);

function resolveFaviconHref(src: string): string {
	if (!src.startsWith("/")) {
		return src;
	}

	const baseUrl = import.meta.env.BASE_URL;
	if (baseUrl !== "/" && src.startsWith(baseUrl)) {
		return src;
	}

	return url(src);
}

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
const canonicalUrl =
	Astro.site && canonicalPath
		? new URL(url(canonicalPath), Astro.site).toString()
		: Astro.url.toString();
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-page-bg text-sm transition md:text-base">
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		{Astro.site && <meta property="og:url" content={canonicalUrl}>}
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		{Astro.site && <meta property="twitter:url" content={canonicalUrl}>}
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{resolvedFavicons.map(favicon => {
			const resolvedHref = resolveFaviconHref(favicon.src);
			const isSvg = resolvedHref.split("?")[0].toLowerCase().endsWith(".svg");
			return (
				<link rel="icon"
					  href={resolvedHref}
					  type={isSvg ? "image/svg+xml" : undefined}
					  sizes={favicon.sizes}
					  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
				/>
			);
		})}

		<Font cssVariable="--font-roboto" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, floatingScrollbarMedia}}>
			if (document.readyState === 'loading' && matchMedia(floatingScrollbarMedia).matches) {
				const rootStyle = document.documentElement.style;
				rootStyle.scrollbarWidth = 'none';
				document.addEventListener('DOMContentLoaded', () => rootStyle.removeProperty('scrollbar-width'), { once: true });
			}

			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
			'github-card-description-lines': siteConfig.githubCard.descriptionLines,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>
		{enablePhotoSwipe && <link rel="stylesheet" href={photoSwipeStylesUrl} data-photoswipe-style="true" />}

		{Astro.site && (
			<link
				rel="alternate"
				type="application/rss+xml"
				title={profileConfig.name}
				href={new URL(url("rss.xml"), Astro.site).toString()}
			/>
		)}

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}>
		<GlobalStyles />
		<ConfigCarrier></ConfigCarrier>
		<GlobalNotices client:load placement={siteConfig.notifications} closeLabel={i18n(I18nKey.pageFeedbackClose)} pinnedLabel={i18n(I18nKey.noticePinned)} regionLabel={i18n(I18nKey.noticeRegion)} />
		<slot />

	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
.enable-banner #banner-wrapper {
	height: var(--banner-height-home);
}

.enable-banner #banner:not(optical-banner) {
	height: var(--banner-height-home);
	transform: translateY(var(--bannerOffset));
}

.enable-banner #top-row {
	height: calc(var(--banner-height-home) - 4.5rem);
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (min-width: 1024px) {
	.enable-banner.lg\:is-home #banner-wrapper {
		height: var(--banner-height-home);
		transform: translateY(var(--banner-height-extend));
	}

	.enable-banner.lg\:is-home #banner:not(optical-banner) {
		height: var(--banner-height-home);
		transform: translateY(0);
	}

	.enable-banner.lg\:is-home #main-grid {
		transform: translateY(var(--banner-height-extend));
	}

	.enable-banner.lg\:is-home #sidebar-sticky {
		top: calc(1rem - var(--banner-height-extend));
	}
}

.navbar-hidden {
	opacity: 0;
	transform: translateY(-4rem);
}
@media (prefers-reduced-motion: reduce) {
	.enable-banner #banner-wrapper, .enable-banner #main-grid {
		transition-property: none;
	}
}
</style>

<script>
import { initFloatingScrollbars } from "../utils/browser/floating-scrollbars";
import { installOpticalTransition } from "../utils/browser/optical-transition/controller";
import { createLiquidRainRenderer } from "../utils/browser/optical-transition/liquid-rain-renderer";
import { resolveSwupAnnouncementText } from "../utils/browser/swup-a11y";
import { notices } from "../utils/browser/notifications";
import { cancelGithubCards, refreshGithubCards } from "../utils/browser/github-cards";
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/browser/theme-settings";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

/* Preload fonts */
// (async function() {
// 	try {
// 		await Promise.all([
// 			document.fonts.load("400 1em Roboto"),
// 			document.fonts.load("700 1em Roboto"),
// 		]);
// 		document.body.classList.remove("hidden");
// 	} catch (error) {
// 		console.log("Failed to load fonts:", error);
// 	}
// })();

/* TODO This is a temporary solution for style flicker issue when the transition is activated */
/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
/* update: fixed in Astro 3.2.4 */
/*
function disableAnimation() {
	const css = document.createElement('style')
	css.appendChild(
		document.createTextNode(
			`*{
              -webkit-transition:none!important;
              -moz-transition:none!important;
              -o-transition:none!important;
              -ms-transition:none!important;
              transition:none!important
              }`
		)
	)
	document.head.appendChild(css)

	return () => {
		// Force restyle
		;(() => window.getComputedStyle(document.body))()

		// Wait for next tick before removing
		setTimeout(() => {
			document.head.removeChild(css)
		}, 1)
	}
}
*/

const isBannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panelId: string, ignoredElementIds: string[]) {
	document.addEventListener("click", event => {
		const panelElement = document.getElementById(panelId);
		const clickTarget = event.target;
		if (!(clickTarget instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (const ignoredElementId of ignoredElementIds) {
			const ignoredElement = document.getElementById(ignoredElementId)
			if (ignoredElement === clickTarget || (ignoredElement?.contains(clickTarget))) {
				return;
			}
		}
		panelElement?.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	showBanner();
	refreshGithubCards();
}

function resolvePageAnnouncement() {
	return resolveSwupAnnouncementText(document, document.title)
}

// Swup A11y 把 busy 写到不允许 ARIA 属性的 html；状态应限定到被替换的 main。
function setContentBusy(isBusy: boolean) {
	document.documentElement.removeAttribute('aria-busy')
	const mainContent = document.querySelector('main')
	if (isBusy) {
		mainContent?.setAttribute('aria-busy', 'true')
	} else {
		mainContent?.removeAttribute('aria-busy')
	}
}

/* Load settings when entering the site */
const refreshFormulaScrollbars = initFloatingScrollbars();
init();

const setup = () => {
	installOpticalTransition(window.swup, createLiquidRainRenderer())
	window.swup.hooks.before('content:replace', () => notices.replacePage())
	window.swup.hooks.on('visit:start', cancelGithubCards)
	window.swup.hooks.on('content:replace', refreshGithubCards)
	window.swup.hooks.on('visit:start', () => setContentBusy(true))
	window.swup.hooks.on('content:replace', () => setContentBusy(true))
	window.swup.hooks.on('visit:end', () => setContentBusy(false))
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!isBannerEnabled) {
			return
		}
		const navbarHideThreshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		const navbarElement = document.getElementById('navbar-wrapper')
		if (!navbarElement || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= navbarHideThreshold || document.documentElement.scrollTop >= navbarHideThreshold) {
			navbarElement.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.before('content:announce', (visit) => {
		const announcement = resolvePageAnnouncement()
		if (!announcement) {
			return
		}

		visit.a11y.announce = announcement
	})
	window.swup.hooks.on('content:replace', refreshFormulaScrollbars)
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

const backToTopButton = document.getElementById('back-to-top-btn');
const tableOfContentsElement = document.getElementById('toc-wrapper');
const navbarElement = document.getElementById('navbar-wrapper')
function scrollFunction() {
	const scrollTop = window.scrollY;
	const bannerScrollThreshold = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopButton) {
		backToTopButton.classList.toggle('hide', scrollTop <= bannerScrollThreshold)
	}

	if (isBannerEnabled && tableOfContentsElement) {
		tableOfContentsElement.classList.toggle('toc-hide', scrollTop <= bannerScrollThreshold)
	}

	if (!isBannerEnabled) return
	if (navbarElement) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let activeBannerHeightPercent = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			activeBannerHeightPercent = BANNER_HEIGHT_HOME
		}
		const navbarHideThreshold = window.innerHeight * (activeBannerHeightPercent / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		navbarElement.classList.toggle('navbar-hidden', scrollTop >= navbarHideThreshold)
	}
}
window.addEventListener('scroll', scrollFunction, { passive: true })

window.addEventListener('resize', () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}, { passive: true })

</script>

<script>
import type PhotoSwipeLightbox from "photoswipe/lightbox"

type PhotoSwipeModule = typeof import("photoswipe")
type PhotoSwipeLightboxModule = typeof import("photoswipe/lightbox")
type PhotoSwipeItemData = {
	src?: string
	w?: number
	h?: number
	msrc?: string
}

let lightbox: PhotoSwipeLightbox | undefined
let photoSwipeLightboxModule: Promise<PhotoSwipeLightboxModule> | undefined
let photoSwipeModule: Promise<PhotoSwipeModule> | undefined

function isPhotoSwipeEnabled() {
	return document.querySelector("#swup-container")?.getAttribute("data-enable-photoswipe") === "true"
}

async function loadPhotoSwipeLightbox() {
	if (!photoSwipeLightboxModule) {
		photoSwipeLightboxModule = import("photoswipe/lightbox")
	}
	if (!photoSwipeModule) {
		photoSwipeModule = import("photoswipe")
	}

	return (await photoSwipeLightboxModule).default
}

async function createPhotoSwipe() {
	if (!isPhotoSwipeEnabled()) {
		return
	}

	const PhotoSwipeLightbox = await loadPhotoSwipeLightbox()
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => photoSwipeModule!,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData: PhotoSwipeItemData, element: Element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (isPhotoSwipeEnabled() && !lightbox) {
		void createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		void createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
			lightbox = undefined
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>
