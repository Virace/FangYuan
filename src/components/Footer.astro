---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<div class="transition my-10 mx-32 border-t border-dashed border-footer-divider"></div>
<div class="transition border-dashed border-footer-divider rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. Licensed under MIT. /
        <a class="transition link text-primary font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-primary font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Built with
        <a class="transition link text-primary font-medium" target="_blank" href="https://astro.build">Astro</a>
    </div>
</div>
