---
import { render } from "astro:content";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { isPinnedPost } from "../utils/content/post-ordering";
import type { PostEntry } from "../utils/content/posts";
import { resolveContentImage } from "../utils/image-source";
import { resolveOpticalCoverPreset } from "../utils/optical-cover-presets";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: PostEntry;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string | ImageMetadata;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props as Props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await render(entry);
const resolvedCoverImage = await resolveContentImage(
	image,
	entry.filePath?.replace(/\\/g, "/"),
);
const fallbackCover = hasCover
	? null
	: resolveOpticalCoverPreset(entry.id || url || title);
const isPinned = isPinnedPost(entry.data);
---
<div class:list={["card-base optical-post-card flex flex-col-reverse md:flex-col w-full rounded-panel overflow-hidden relative md:min-h-[12.75rem]", className]} style={style}>
    <div class="optical-card-blur-band hidden md:block pointer-events-none" aria-hidden="true"></div>
    <div class="optical-card-text-scrim hidden md:block pointer-events-none" aria-hidden="true"></div>

    <div class:list={["optical-card-content relative z-10 pl-6 md:pl-9 pr-6 md:pr-4 pt-5 md:pt-7 pb-6 flex-1 flex flex-col justify-between w-full", hasCover ? "md:w-[70%]" : "md:w-[78%]"]}>
        <div>
            <a href={url} data-transition-title={title}
               class="transition group w-full block font-bold mb-3 text-3xl text-90
            hover:text-accent-solid
            active:text-title-active
            optical-post-title-beam
            before:absolute before:top-8.75 before:left-4.5 before:hidden md:before:block
            ">
                {isPinned && (
                    <span
                        class="relative -top-[0.08em] inline-block whitespace-nowrap text-[0.56em] leading-none align-middle font-black tracking-[0.18em] text-accent-solid uppercase"
                    >
                        {i18n(I18nKey.pinned)}
                    </span>
                )}
                {title}
                <Icon is:inline class="inline icon-32 text-primary md:hidden translate-y-0.5 absolute" name="material-symbols:chevron-right-rounded" ></Icon>
                <Icon is:inline class="text-primary icon-32 transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" name="material-symbols:chevron-right-rounded"></Icon>
            </a>

            <!-- metadata -->
            <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="mb-4"></PostMetadata>

            <!-- description -->
            <div class:list={["transition text-75 mb-3.5 pr-4", {"line-clamp-2 md:line-clamp-1": !description}]}>
                { description || remarkPluginFrontmatter.excerpt }
            </div>
        </div>

        <!-- word count and read time  -->
        <div class="text-sm text-muted flex gap-4 transition">
            <div>
                {remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
            </div>
            <div>|</div>
            <div>
                {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
            </div>
        </div>

    </div>

    {hasCover && <a href={url} aria-label={title}
                    class="optical-card-cover-link group block relative h-48 md:h-auto md:inset-0 md:absolute z-0 overflow-hidden" >
        <div class="optical-card-focus-mark hidden md:flex items-center justify-center pointer-events-none">
            <Icon is:inline name="material-symbols:chevron-right-rounded" class="text-xl" />
        </div>
        <div class="optical-card-cover-media w-full h-full">
            <ImageWrapper src={resolvedCoverImage} alt="Cover Image of the Post"
                      class="w-full h-full">
            </ImageWrapper>
        </div>
    </a>}

    {!hasCover && fallbackCover && (
        <a href={url} aria-label={title}
           class="optical-card-cover-link group block relative h-32 md:h-auto md:inset-0 md:absolute z-0 overflow-hidden">
            <div class="optical-card-focus-mark hidden md:flex items-center justify-center pointer-events-none">
                <Icon is:inline name="material-symbols:chevron-right-rounded" class="text-xl" />
            </div>
            <div
                class="optical-card-cover-media w-full h-full"
                style={`background: ${fallbackCover.background};`}
                aria-hidden="true"
            ></div>
        </a>
    )}
</div>
<div class="optical-hairline mx-6 w-auto! last:hidden md:hidden" aria-hidden="true"></div>
