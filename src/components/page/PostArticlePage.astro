---
import { render } from "astro:content";
import CommentSection from "@components/comments/CommentSection.svelte";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import PostFeedback from "@components/page-feedback/PostFeedback.svelte";
import PageViewCounter from "@components/page-metrics/PageViewCounter.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostKeyFromEntry } from "@utils/comments/post-key";
import type { PostEntry } from "@utils/content-utils";
import { resolveContentImage } from "@utils/image-source";
import { shouldEnablePhotoSwipe } from "@utils/photoswipe-utils";
import { resolveTocConfig } from "@utils/toc-config";
import { url } from "@utils/url-utils";
import type { ImageMetadata, MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	licenseConfig,
	pageFeedbackConfig,
	pageMetricsConfig,
	profileConfig,
	siteConfig,
} from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import PostMetadata from "../PostMeta.astro";

const { entry } = Astro.props as {
	entry: PostEntry;
};
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const hasPrimaryHeading = headings.some(
	(heading: MarkdownHeading) => heading.depth === 1,
);
const enablePhotoSwipe = shouldEnablePhotoSwipe(entry.body, entry.data.image);
const resolvedCoverImage = await resolveContentImage(
	entry.data.image as string | ImageMetadata | undefined,
	entry.filePath?.replace(/\\/g, "/"),
);
const resolvedToc = resolveTocConfig({
	pageKind: "post",
	siteToc: siteConfig.toc,
	headingsCount: headings.length,
	frontmatterToc: entry.data.toc,
});
const postKey = getPostKeyFromEntry(entry.id);
const postUrl = Astro.url.toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} resolvedToc={resolvedToc} enablePhotoSwipe={enablePhotoSwipe}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-panel overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ", {}]}>
            {!hasPrimaryHeading && <h1 class="sr-only">{entry.data.title}</h1>}

            <div class="flex flex-row text-30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-soft-contrast text-50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-soft-contrast text-50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-4xl/11
                    text-90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-primary
                    before:absolute before:top-3 before:-left-4.5
                ">
                    {entry.data.title}
                </div>
            </div>

            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {pageMetricsConfig.enable && pageMetricsConfig.qingyan && (
                    <div class="mb-5">
                        <PageViewCounter client:only="svelte" postKey={postKey} postTitle={entry.data.title} postUrl={postUrl} />
                    </div>
                )}
                {!entry.data.image && <div class="border-line-divider border-dashed border-b mb-5"></div>}
            </div>

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={resolvedCoverImage} class="mb-8 rounded-xl banner-container onload-animation"/>
            }

            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {pageFeedbackConfig.enable && (
                <PostFeedback
                    client:only="svelte"
                    postKey={postKey}
                    postTitle={entry.data.title}
                    postUrl={postUrl}
                    rewardOptions={pageFeedbackConfig.rewardOptions ?? []}
                />
            )}

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <div class="w-full font-bold overflow-hidden">
            {entry.data.nextSlug && entry.data.nextPermalink && <a href={url(entry.data.nextPermalink)} class="block active:scale-95">
                <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4" >
                    <Icon name="material-symbols:chevron-left-rounded" class="icon-32 text-primary" />
                    <div class="post-nav-title transition text-75 text-left">
                        {entry.data.nextTitle}
                    </div>
                </div>
            </a>}
        </div>

        <div class="w-full font-bold overflow-hidden">
            {entry.data.prevSlug && entry.data.prevPermalink && <a href={url(entry.data.prevPermalink)} class="block active:scale-95">
                <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
                    <div class="post-nav-title transition text-75 text-right">
                        {entry.data.prevTitle}
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="icon-32 text-primary" />
                </div>
            </a>}
        </div>
    </div>

    {commentConfig.enable && commentConfig.qingyan && (
        <CommentSection
            client:only="svelte"
            postKey={postKey}
            postTitle={entry.data.title}
            postUrl={postUrl}
            rootLimit={commentConfig.rootLimit}
            maxDepth={commentConfig.maxDepth}
        />
    )}

</MainGridLayout>
