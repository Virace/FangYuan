---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { url } from "../../utils/permalink/urls";

interface Props {
	id?: string;
	src?: ImageMetadata | string;
	class?: string;
	alt?: string;
	position?: string;
}

const { id, src, alt, position = "center" } = Astro.props;
const className = Astro.props.class;

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
const isStringSource = typeof src === "string";
const isPublic = isStringSource && src.startsWith("/");
---
<div id={id} class:list={[className, "overflow-hidden relative"]}>
	<div class="transition absolute inset-0 dark:bg-black/10 pointer-events-none"></div>
	{src && !isStringSource && (
		<Image src={src} alt={alt || ""} class={imageClass} style={imageStyle} />
	)}
	{src && isStringSource && (
		<img
			src={isPublic ? url(src) : src}
			alt={alt || ""}
			class={imageClass}
			style={imageStyle}
		/>
	)}
</div>
