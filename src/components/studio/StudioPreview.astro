---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import Markdown from "../misc/Markdown.astro";
---

<MainGridLayout title="文章预览" headings={[]} resolvedToc={{ enable: true, depth: 3 }}>
	<article class="card-base px-6 py-6 md:px-9 md:py-8">
		<h1 id="preview-title" class="font-bold text-3xl text-90 mb-5">文章预览</h1>
		<div id="preview-metadata"></div>
		<div id="preview-cover"></div>
		<Markdown class="fangyuan-canvas">
			<div id="preview-body"></div>
		</Markdown>
	</article>
</MainGridLayout>
