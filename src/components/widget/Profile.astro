---
import { Icon } from "astro-icon/components";
import {
	configImageBaseRoots,
	navBarConfig,
	navBarI18n,
	profileConfig,
} from "../../config";
import { LinkPresets } from "../../constants/link-presets";
import { resolveI18nKey } from "../../i18n/translation";
import { getContentRouteManifest } from "../../utils/content-routes";
import { resolveConfigImage } from "../../utils/image-source";
import { getNavBarLinkId, resolveNavbarLinks } from "../../utils/navbar-links";
import { url } from "../../utils/permalink/urls";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const avatarSource = await resolveConfigImage(
	config.avatar,
	configImageBaseRoots.avatar,
);
const manifest = await getContentRouteManifest();
const aboutLinkId = getNavBarLinkId(LinkPresets.About);
const aboutLink = resolveNavbarLinks(navBarConfig.links, manifest, {
	translateLabel: (key) => resolveI18nKey(key, navBarI18n),
}).find((link) => link.id === aboutLinkId);

if (!aboutLink) {
	throw new Error("About page content not found");
}
---
<div class="card-base p-3">
    <a aria-label="Go to About Page" href={url(aboutLink.url)}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={avatarSource} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-primary mx-auto rounded-full mb-2 transition"></div>
        <div class="text-center text-neutral-400 mb-2.5 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-2xl"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={config.links[0].icon} class="text-2xl"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>
