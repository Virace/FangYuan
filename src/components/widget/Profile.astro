---
import { Icon } from "astro-icon/components";
import {
	configImageBaseRoots,
	navBarConfig,
	navBarI18n,
	profileConfig,
} from "../../config";
import { LinkPresets } from "../../constants/link-presets";
import { resolveI18nKey } from "../../i18n/translation";
import { getContentRouteManifest } from "../../utils/content-routes";
import { resolveConfigImage } from "../../utils/image-source";
import { getNavBarLinkId, resolveNavbarLinks } from "../../utils/navbar-links";
import { url } from "../../utils/permalink/urls";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const avatarSource = await resolveConfigImage(
	config.avatar,
	configImageBaseRoots.avatar,
);
const manifest = await getContentRouteManifest();
const aboutLinkId = getNavBarLinkId(LinkPresets.About);
const aboutLink = resolveNavbarLinks(navBarConfig.links, manifest, {
	translateLabel: (key) => resolveI18nKey(key, navBarI18n),
}).find((link) => link.id === aboutLinkId);

if (!aboutLink) {
	throw new Error("About page content not found");
}
const linkEffect = config.linkEffect ?? "expand";
---
<div class="card-base panel-edge profile-optical-card relative p-3">
    <span class="profile-optical-topline" aria-hidden="true"></span>
    <a aria-label="Go to About Page" data-transition-title={aboutLink.name} href={url(aboutLink.url)}
       class="profile-avatar-link group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <span class="profile-avatar-sheen" aria-hidden="true"></span>
        <span class="profile-about-pill" aria-hidden="true">{aboutLink.name}</span>
        <ImageWrapper src={avatarSource} alt="Profile Image of the Author" class="profile-avatar-img mx-auto lg:w-full h-full lg:mt-0"></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="profile-optical-rule my-2 transition" aria-hidden="true"></div>
        <div class="text-center text-muted mb-2.5 transition">{config.bio}</div>
        <div class:list={[
            "profile-social-links flex flex-wrap gap-2 justify-center mb-1",
            config.links.length > 1 ? `profile-social-${linkEffect}` : "",
        ]}>
            {config.links.length > 1 && config.links.map(item =>
                linkEffect === "lift" ? (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular profile-social-btn-lift rounded-lg h-10 w-10 active:scale-90">
                        <span class="profile-social-lift-track" aria-hidden="true">
                            <span class="profile-social-lift-slot">
                                <Icon name={item.icon} class="text-2xl"></Icon>
                            </span>
                            <span class="profile-social-lift-slot profile-social-lift-slot-glow">
                                <Icon name={item.icon} class="text-2xl"></Icon>
                            </span>
                        </span>
                    </a>
                ) : (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular profile-social-btn-expand rounded-lg h-10 active:scale-95">
                        <Icon name={item.icon} class="profile-social-icon text-xl shrink-0" aria-hidden="true"></Icon>
                        <span class="profile-social-label" aria-hidden="true">{item.name}</span>
                    </a>
                )
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={config.links[0].icon} class="text-2xl"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>
