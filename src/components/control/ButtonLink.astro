---
interface Props {
	badge?: string;
	url?: string;
}
const { badge, url } = Astro.props;
---
<a href={url}
    class="group optical-cat-row"
    >
        <span class="optical-cat-beam" aria-hidden="true"></span>
        <div class="flex items-center justify-between relative w-full min-w-0">
            <div class="overflow-hidden text-left whitespace-nowrap text-ellipsis">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' && (
                <>
                    <span class="optical-cat-leader" aria-hidden="true"></span>
                    <div class="optical-cat-count">
                        { badge }
                    </div>
                </>
            )}
        </div>
</a>
