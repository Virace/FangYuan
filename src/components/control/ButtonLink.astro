---
interface Props {
	badge?: string;
	url?: string;
}
const { badge, url } = Astro.props;
---
<a href={url}
    class:list={`
            group flex items-center
            w-full
            h-10
            rounded-lg
            bg-transparent
            hover:bg-btn-plain-bg-hover
            active:bg-btn-plain-bg-active
            transition-all
            pl-2
            hover:pl-3
            
            text-neutral-700
            hover:text-accent-foreground focus-visible:text-accent-foreground
            focus-visible:bg-btn-plain-bg-hover
            dark:text-neutral-300
        `
        }
    >
        <div class="flex items-center justify-between relative mr-2 w-full">
            <div class="overflow-hidden text-left whitespace-nowrap text-ellipsis">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition px-2 h-7 ml-4 min-w-8 rounded-lg text-sm font-bold
                    text-btn-content dark:text-deep-text
                    bg-btn-regular-bg dark:bg-primary
                    group-hover:bg-accent-solid group-focus-visible:bg-accent-solid
                    not-dark:group-hover:text-white not-dark:group-focus-visible:text-white
                    flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
</a>
