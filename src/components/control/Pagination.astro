---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { getHomePaginationPath, url } from "../../utils/permalink/urls";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN_PAGE_ITEM = -1;

const className = Astro.props.class;

const ADJACENT_PAGE_DISTANCE = 2;
const VISIBLE_PAGE_COUNT = ADJACENT_PAGE_DISTANCE * 2 + 1;

let visiblePageCount = 1;
let firstVisiblePage = page.currentPage;
let lastVisiblePage = page.currentPage;
while (
	0 < firstVisiblePage - 1 &&
	lastVisiblePage + 1 <= page.lastPage &&
	visiblePageCount + 2 <= VISIBLE_PAGE_COUNT
) {
	visiblePageCount += 2;
	firstVisiblePage--;
	lastVisiblePage++;
}
while (0 < firstVisiblePage - 1 && visiblePageCount < VISIBLE_PAGE_COUNT) {
	visiblePageCount++;
	firstVisiblePage--;
}
while (
	lastVisiblePage + 1 <= page.lastPage &&
	visiblePageCount < VISIBLE_PAGE_COUNT
) {
	visiblePageCount++;
	lastVisiblePage++;
}

const pageItems: number[] = [];
if (firstVisiblePage > 1) pageItems.push(1);
if (firstVisiblePage === 3) pageItems.push(2);
if (firstVisiblePage > 3) pageItems.push(HIDDEN_PAGE_ITEM);
for (
	let pageNumber = firstVisiblePage;
	pageNumber <= lastVisiblePage;
	pageNumber++
) {
	pageItems.push(pageNumber);
}
if (lastVisiblePage < page.lastPage - 2) pageItems.push(HIDDEN_PAGE_ITEM);
if (lastVisiblePage === page.lastPage - 2) {
	pageItems.push(page.lastPage - 1);
}
if (lastVisiblePage < page.lastPage) pageItems.push(page.lastPage);

const getPageUrl = (pageNumber: number) => {
	return getHomePaginationPath(pageNumber);
};
const prevPageUrl =
	page.currentPage > 1 ? url(getPageUrl(page.currentPage - 1)) : null;
const nextPageUrl =
	page.currentPage < page.lastPage
		? url(getPageUrl(page.currentPage + 1))
		: null;
---

<div class:list={[className, "flex flex-row gap-3 justify-center"]} style={style}>
    <div class="w-11 h-11">
        {prevPageUrl
            ? <a href={prevPageUrl} aria-label="Previous Page"
                class="btn-card overflow-hidden rounded-lg text-primary w-11 h-11"
            >
                <Icon name="material-symbols:chevron-left-rounded" class="icon-28"></Icon>
            </a>
            : <div class="btn-card disabled overflow-hidden rounded-lg text-primary w-11 h-11">
                <Icon name="material-symbols:chevron-left-rounded" class="icon-28"></Icon>
            </div>
        }
    </div>
    <div class="bg-card-bg flex flex-row rounded-lg items-center text-neutral-700 dark:text-neutral-300 font-bold">
        {pageItems.map((pageNumber) => {
            if (pageNumber === HIDDEN_PAGE_ITEM)
                return <Icon is:inline name="material-symbols:more-horiz" class="mx-1"/>;
            if (pageNumber === page.currentPage)
                return <div class="h-11 w-11 rounded-lg bg-primary flex items-center justify-center
                    font-bold text-pagination-current-content"
                >
                    {pageNumber}
                </div>
            return <a href={url(getPageUrl(pageNumber))} aria-label={`Page ${pageNumber}`}
                class="btn-card w-11 h-11 rounded-lg overflow-hidden active:scale-[0.85]"
            >{pageNumber}</a>
        })}
    </div>
    <div class="w-11 h-11">
        {nextPageUrl
            ? <a href={nextPageUrl} aria-label="Next Page"
                class="btn-card overflow-hidden rounded-lg text-primary w-11 h-11"
            >
                <Icon is:inline name="material-symbols:chevron-right-rounded" class="icon-28"></Icon>
            </a>
            : <div class="btn-card disabled overflow-hidden rounded-lg text-primary w-11 h-11">
                <Icon is:inline name="material-symbols:chevron-right-rounded" class="icon-28"></Icon>
            </div>
        }
    </div>
</div>
