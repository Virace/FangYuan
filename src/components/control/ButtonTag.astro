---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="btn-regular h-8 text-sm px-3 rounded-lg">
    {dot && <div class="h-1 w-1 bg-btn-content dark:bg-card-bg transition rounded-md mr-2" aria-hidden="true"></div>}
    {!dot && <span class="optical-tag-hash" aria-hidden="true">#</span>}
    <slot></slot>
</a>
