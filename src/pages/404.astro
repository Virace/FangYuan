---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getArchivePath, url } from "@utils/url-utils";

const pageTitle = "页面未找到";
---

<MainGridLayout title={pageTitle} description="请求的页面不存在或已经移动。">
	<section class="card-base rounded-panel px-6 py-10 text-center md:px-10 md:py-14">
		<p class="mb-3 text-sm font-bold tracking-normal text-primary">404</p>
		<h1 class="text-3xl font-bold text-90 md:text-4xl">{pageTitle}</h1>
		<p class="mx-auto mt-4 max-w-xl text-base leading-7 text-50">
			请求的页面不存在，或内容已经移动到新的地址。
		</p>
		<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a class="btn-card h-11 rounded-lg px-5 font-bold text-primary" href={url("/")}>
				返回主页
			</a>
			<a
				class="btn-card h-11 rounded-lg px-5 font-bold text-primary"
				href={url(getArchivePath())}
			>
				查看归档
			</a>
		</div>
	</section>
</MainGridLayout>
