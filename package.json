{
  "name": "fangyuan",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "dev:internal": "cross-env FANGYUAN_SITE_MODE=internal astro dev",
    "dev:external": "cross-env FANGYUAN_SITE_MODE=external astro dev",
    "dev:mock": "node scripts/qingyan/dev-with-qingyan-mock.mjs",
    "dev:full": "node scripts/qingyan/dev-with-qingyan.mjs",
    "cloudflare:demo:smoke": "node scripts/cloudflare/demo-deploy.mjs smoke",
    "cloudflare:demo:dev": "node scripts/cloudflare/demo-deploy.mjs dev",
    "cloudflare:demo:deploy": "node scripts/cloudflare/demo-deploy.mjs deploy",
    "qingyan:scenario": "node scripts/qingyan/qingyan-dev-control.mjs scenario",
    "qingyan:reset": "node scripts/qingyan/qingyan-dev-control.mjs reset",
    "qingyan:state": "node scripts/qingyan/qingyan-dev-control.mjs state",
    "start": "astro dev",
    "check": "astro check",
    "check:internal": "cross-env FANGYUAN_SITE_MODE=internal astro check",
    "check:external": "cross-env FANGYUAN_SITE_MODE=external astro check",
    "build": "node scripts/site/build-site.mjs",
    "build:internal": "cross-env FANGYUAN_SITE_MODE=internal node scripts/site/build-site.mjs",
    "build:external": "cross-env FANGYUAN_SITE_MODE=external node scripts/site/build-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test:node": "node --test --test-concurrency=1",
    "test:e2e": "pnpm build:internal && playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/interaction.spec.ts tests/e2e/a11y.spec.ts tests/e2e/aria.spec.ts tests/e2e/upgrade-regression.spec.ts",
    "test:e2e:headed": "pnpm build:internal && playwright test --headed tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/interaction.spec.ts tests/e2e/a11y.spec.ts tests/e2e/aria.spec.ts tests/e2e/upgrade-regression.spec.ts",
    "test:e2e:visual": "pnpm build:internal && playwright test tests/e2e/visual.spec.ts",
    "test:e2e:update": "pnpm build:internal && playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/content/new-post.js",
    "generate-pagination-test-posts": "node scripts/content/generate-pagination-test-posts.js",
    "format": "biome check --write ./src",
    "lint": "biome check ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "8.1.2",
    "@expressive-code/core": "^0.43.1",
    "@expressive-code/plugin-collapsible-sections": "^0.43.1",
    "@expressive-code/plugin-line-numbers": "^0.43.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.77",
    "@iconify/svelte": "^5.2.1",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "6.4.6",
    "astro-expressive-code": "^0.43.1",
    "astro-icon": "^1.1.5",
    "hastscript": "^9.0.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.0",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.9",
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.61.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/hast": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.1",
    "cross-env": "^7.0.3",
    "svelte-check": "^4.6.0"
  },
  "packageManager": "pnpm@9.14.4"
}
