{
  "name": "fangyuan",
  "private": true,
  "type": "module",
  "version": "0.2.2",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:internal": "cross-env FANGYUAN_SITE_MODE=internal astro dev",
    "dev:external": "cross-env FANGYUAN_SITE_MODE=external astro dev",
    "dev:mock": "node scripts/qingyan/dev-with-qingyan-mock.mjs",
    "dev:full": "node scripts/qingyan/dev-with-qingyan.mjs",
    "cloudflare:demo:smoke": "node scripts/cloudflare/demo-deploy.mjs smoke",
    "cloudflare:demo:dev": "node scripts/cloudflare/demo-deploy.mjs dev",
    "cloudflare:demo:deploy": "node scripts/cloudflare/demo-deploy.mjs deploy",
    "qingyan:scenario": "node scripts/qingyan/qingyan-dev-control.mjs scenario",
    "qingyan:reset": "node scripts/qingyan/qingyan-dev-control.mjs reset",
    "qingyan:state": "node scripts/qingyan/qingyan-dev-control.mjs state",
    "start": "astro dev",
    "check": "astro check",
    "check:internal": "cross-env FANGYUAN_SITE_MODE=internal astro check",
    "check:external": "cross-env FANGYUAN_SITE_MODE=external astro check",
    "build": "node scripts/site/build-site.mjs",
    "build:internal": "cross-env FANGYUAN_SITE_MODE=internal node scripts/site/build-site.mjs",
    "build:external": "cross-env FANGYUAN_SITE_MODE=external node scripts/site/build-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm test:node",
    "test:node": "node --test \"tests/*.test.mjs\"",
    "test:build": "node --test --test-concurrency=1 \"tests/site-build.integration.mjs\" \"tests/github-card-build.integration.mjs\"",
    "test:system": "pnpm test && pnpm test:build && pnpm test:e2e",
    "test:e2e": "node tests/test-helpers/build-internal.mjs && playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/interaction.spec.ts tests/e2e/a11y.spec.ts tests/e2e/aria.spec.ts tests/e2e/upgrade-regression.spec.ts tests/e2e/github-cards.spec.ts",
    "test:e2e:headed": "node tests/test-helpers/build-internal.mjs && playwright test --headed tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/interaction.spec.ts tests/e2e/a11y.spec.ts tests/e2e/aria.spec.ts tests/e2e/upgrade-regression.spec.ts tests/e2e/github-cards.spec.ts",
    "test:e2e:visual": "node tests/test-helpers/build-internal.mjs && playwright test tests/e2e/visual.spec.ts",
    "test:e2e:update": "node tests/test-helpers/build-internal.mjs && playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/content/new-post.js",
    "generate-pagination-test-posts": "node scripts/content/generate-pagination-test-posts.js",
    "format": "biome check --write ./src",
    "lint": "biome check ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "0.4.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "9.1.4",
    "@expressive-code/core": "^0.44.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.98",
    "@iconify/svelte": "^5.2.4",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "7.4.10",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "hastscript": "^9.0.3",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.17.0",
    "pagefind": "^1.6.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.18.1",
    "satteri": "0.11.7",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.11.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.2",
    "cross-env": "^10.1.0",
    "svelte-check": "^4.7.8"
  },
  "packageManager": "pnpm@12.18.0"
}
